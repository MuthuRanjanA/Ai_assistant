# AI Assistant Environment Variables

# ==========================================
# 1. GROQ CONFIGURATION (SUPER FAST & FREE TIER)
# Obtain your free key from https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models (Very fast inference):
# - llama-3.3-70b-versatile  (Recommended - best quality)
# - llama-3.1-8b-instant     (Ultra fast)
# - deepseek-r1-distill-llama-70b
# - mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# 2. OPENROUTER CONFIGURATION (OPTIONAL)
# ==========================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ==========================================
# 3. GOOGLE GEMINI DIRECT (OPTIONAL)
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
